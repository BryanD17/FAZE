# dependencies
node_modules/
.npm/

# build output
dist/
build/
*.tsbuildinfo
client/dist/
server/dist/
shared/dist/

# environment — never commit real secrets (R10)
.env
.env.local
.env.*.local

# data: raw dumps, API caches and database dumps are reproducible, not source
db/data/raw/*
!db/data/raw/.gitkeep
db/data/cache/*
!db/data/cache/.gitkeep
db/dumps/*
!db/dumps/.gitkeep

# test + coverage artifacts
coverage/
.nyc_output/
*.lcov

# editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# logs
*.log
npm-debug.log*
