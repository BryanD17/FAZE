# ---------------------------------------------------------------------------
# FAZE environment template.
# Copy to .env (`cp .env.example .env`) and fill in real values.
# .env is gitignored — NEVER commit a real secret (master prompt rule R10).
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Matches the `db` service in docker-compose.yml out of the box.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=faze
# Test database used by `npm test` and CI. Never point this at DB_NAME.
DB_NAME_TEST=faze_test
# Optional single-URL form, used by hosted providers (Railway/PlanetScale).
# When set it overrides the discrete DB_* values above.
DATABASE_URL=

# --- Server ---------------------------------------------------------------
# Port the Express API listens on.
PORT=4000
# Origin allowed by CORS; must match where the Vite client is served.
CLIENT_ORIGIN=http://localhost:5173
# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# development | test | production
NODE_ENV=development

# --- Auth -----------------------------------------------------------------
# Generate each with: openssl rand -base64 48
# These MUST be different from each other and rotated if ever exposed.
JWT_ACCESS_SECRET=replace-me-with-openssl-rand-base64-48
JWT_REFRESH_SECRET=replace-me-with-a-different-openssl-rand-base64-48
# Dev-only escape hatch: allows login before email verification.
# Must be false in production.
ALLOW_UNVERIFIED_LOGIN=true

# --- External game data APIs (AGENT 02 enrichment) ------------------------
# RAWG: free key from https://rawg.io/apidocs (sign up -> API key).
# If absent, the ETL logs "enrichment skipped" and exits 0 — it never fakes data.
RAWG_API_KEY=
# IGDB via Twitch: create an app at https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Demo / safety --------------------------------------------------------
# Startup refuses to boot in production with synthetic seed rows present
# unless this is explicitly true (AGENT 14). The hosted academic demo sets it.
ALLOW_SYNTHETIC=false

# --- Client (Vite; must be prefixed VITE_ to be exposed to the browser) ---
VITE_API_BASE_URL=http://localhost:4000
